{
  "name": "saltator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Saltator — an event-driven digital logic simulator for designing and testing 74HC-based (and beyond) computers before building them.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:layers": "node scripts/check-layers.ts",
    "check:roadmap": "node scripts/roadmap-cli.ts --check",
    "roadmap": "node scripts/roadmap-cli.ts",
    "test:circuits": "node --import ./scripts/resolve-hooks.ts scripts/test-circuits.ts",
    "test:65c02": "node --import ./scripts/resolve-hooks.ts scripts/test-65c02.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:layers && pnpm check:roadmap && pnpm test",
    "bench": "vitest bench --run --reporter=verbose --experimental.viteModuleRunner=false --execArgv=--import=./scripts/resolve-hooks.ts",
    "hdl:fixtures": "node --import ./scripts/resolve-hooks.ts scripts/hdl-fixtures.ts",
    "hdl:examples": "node --import ./scripts/resolve-hooks.ts scripts/hdl-examples.ts",
    "hdl:differential": "node --import ./scripts/resolve-hooks.ts scripts/hdl-differential.ts",
    "hdl:library": "node --import ./scripts/resolve-hooks.ts scripts/hdl-library.ts",
    "riscv:firmware": "node --import ./scripts/resolve-hooks.ts scripts/riscv-firmware.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
