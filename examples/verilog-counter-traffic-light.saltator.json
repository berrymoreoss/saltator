        { "id": "w24", "from": [60, 28], "to": [64, 28] }
      ],
      "testScript": [
        "// The board: a 4 Hz clock; RST resets both modules, the light steps on the counter's carry.",
        "bench('counts, and steps the light every ten clocks', (b) => {",
        "  b.set({ SW1: 1, SW2: 1 });",
        "  b.wait(ms(300));",
        "  b.expect({ 'Q[3..0]': 0, RED: 1, GREEN: 0 }, 'reset');",
        "  b.set({ SW1: 0 });",
        "  b.wait(ms(1000));",
        "  b.expect({ 'Q[3..0]': 4, RED: 1 }, 'four clocks later');",
        "  b.wait(ms(1500));",
        "  b.expect({ 'Q[3..0]': 0, RED: 0, GREEN: 1 }, 'the carry stepped the light');",
        "});",
        ""
      ]
