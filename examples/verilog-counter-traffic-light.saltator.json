    {
      "id": "decade-counter",
      "name": "Decade Counter",
      "verilog": {
        "module": {
          "format": 1,
          "top": "decade_counter",
          "creator": "Yosys 0.70+post (git sha1 0c11ea098be065e585a90a06e7b7da49936cf231, Release, AppleClang clang++ 21.0.0.21000334)",
          "bitCount": 17,
          "ports": [
            { "name": "clk", "dir": "in", "lsb": 0, "bits": [0], "src": "decade_counter.v:4.11-4.14" },
            { "name": "rst", "dir": "in", "lsb": 0, "bits": [1], "src": "decade_counter.v:5.11-5.14" },
            { "name": "en", "dir": "in", "lsb": 0, "bits": [2], "src": "decade_counter.v:6.11-6.13" },
            { "name": "q", "dir": "out", "lsb": 0, "bits": [3, 4, 5, 6], "src": "decade_counter.v:7.22-7.23" },
            { "name": "co", "dir": "out", "lsb": 0, "bits": [7], "src": "decade_counter.v:8.12-8.14" }
          ],
          "signals": [],
          "memories": [],
          "cells": [
            { "type": "$add", "src": "decade_counter.v:12.44-12.52", "ports": { "A": [3, 4, 5, 6], "B": ["1", "0", "0", "0"], "Y": [8, 9, 10, 11] }, "params": {} },
            { "type": "$and", "src": "decade_counter.v:13.15-13.31", "ports": { "A": [2], "B": [12], "Y": [7] }, "params": {} },
            { "type": "$adffe", "src": "decade_counter.v:10.3-12.53", "ports": { "CLK": [0], "ARST": [1], "EN": [2], "D": [13, 14, 15, 16], "Q": [3, 4, 5, 6] }, "params": { "CLK_POLARITY": 1, "ARST_POLARITY": 1, "EN_POLARITY": 1, "ARST_VALUE": ["0", "0", "0", "0"] } },
            { "type": "$eq", "src": "decade_counter.v:13.21-13.30", "ports": { "A": [3, 4, 5, 6], "B": ["1", "0", "0", "1"], "Y": [12] }, "params": {} },
            { "type": "$mux", "src": "decade_counter.v:12.23-12.52", "ports": { "A": [8, 9, 10, 11], "B": ["0", "0", "0", "0"], "S": [12], "Y": [13, 14, 15, 16] }, "params": {} }
          ]
        }
      },
      "testScript": [
        "// The counter alone: reset, ten clocks with the carry at 9, and holding while disabled.",
        "bench('counts 0-9 and carries', (b) => {",
        "  b.row({ rst: 1, en: 1, clk: 0 }, { 'q[3..0]': 0, co: 0 });",
        "  b.set({ rst: 0 });",
        "  for (let n = 1; n <= 12; n++) {",
        "    b.row({ clk: 'C' }, { 'q[3..0]': n % 10, co: n % 10 === 9 ? 1 : 0 }, `clock ${n}`);",
        "  }",
        "});",
        "",
        "bench('holds while disabled, without a carry', (b) => {",
        "  b.row({ rst: 1, en: 1, clk: 0 }, { 'q[3..0]': 0 });",
        "  b.set({ rst: 0 });",
        "  b.clock('clk', 9);",
        "  b.table`",
        "    en clk | q[3..0] co",
        "    1  -   | 9       1",
        "    0  -   | 9       0     # co only while enabled",
        "    0  C   | 9       0     # disabled: holds",
        "    1  C   | 0       0",
        "  `;",
        "});",
        "",
        "bench('starts unknown until reset', (b) => {",
        "  b.row({ rst: 0, en: 1, clk: 0 }, { 'q[3..0]': 'unknown' });",
        "});",
        ""
      ]
    },
    {
      "id": "traffic-light",
      "name": "Traffic Light",
      "verilog": {
        "module": {
          "format": 1,
          "top": "traffic_light",
          "creator": "Yosys 0.70+post (git sha1 0c11ea098be065e585a90a06e7b7da49936cf231, Release, AppleClang clang++ 21.0.0.21000334)",
          "bitCount": 12,
          "ports": [
            { "name": "clk", "dir": "in", "lsb": 0, "bits": [0], "src": "traffic_light.v:4.11-4.14" },
            { "name": "rst", "dir": "in", "lsb": 0, "bits": [1], "src": "traffic_light.v:5.11-5.14" },
            { "name": "tick", "dir": "in", "lsb": 0, "bits": [2], "src": "traffic_light.v:6.11-6.15" },
            { "name": "red", "dir": "out", "lsb": 0, "bits": [3], "src": "traffic_light.v:7.12-7.15" },
            { "name": "yellow", "dir": "out", "lsb": 0, "bits": [4], "src": "traffic_light.v:8.12-8.18" },
            { "name": "green", "dir": "out", "lsb": 0, "bits": [5], "src": "traffic_light.v:9.12-9.17" }
          ],
          "signals": [
            { "name": "state", "lsb": 0, "bits": [8, 9], "src": "traffic_light.v:12.13-12.18" }
          ],
          "memories": [],
          "cells": [
            { "type": "$sdffe", "src": "traffic_light.v:13.3-20.14", "ports": { "CLK": [0], "SRST": [1], "EN": [2], "D": [6, 7], "Q": [8, 9] }, "params": { "CLK_POLARITY": 1, "SRST_POLARITY": 1, "EN_POLARITY": 1, "SRST_VALUE": ["0", "0"] } },
            { "type": "$eq", "src": "traffic_light.v:21.32-21.45", "ports": { "A": [8, 9], "B": ["1", "1"], "Y": [10] }, "params": {} },
            { "type": "$eq", "src": "traffic_light.v:22.19-22.34", "ports": { "A": [8, 9], "B": ["0", "1"], "Y": [4] }, "params": {} },
            { "type": "$logic_or", "src": "traffic_light.v:21.16-21.45", "ports": { "A": [11], "B": [10], "Y": [3] }, "params": {} },
            { "type": "$logic_not", "src": "traffic_light.v:16.19-16.19", "ports": { "A": [8, 9], "Y": [11] }, "params": {} },
            { "type": "$pmux", "src": "traffic_light.v:17.29-17.29", "ports": { "A": ["0", "0"], "B": ["0", "1", "1", "0"], "S": [5, 11], "Y": [6, 7] }, "params": {} },
            { "type": "$eq", "src": "traffic_light.v:17.29-17.29", "ports": { "A": [8, 9], "B": ["1", "0"], "Y": [5] }, "params": {} }
          ]
        }
      },
      "testScript": [
        "// The state machine alone: reset to red, then one step per clock while tick is HIGH. The",
        "// state register is read inside the module (RED 0, GREEN 1, YELLOW 2), as the lights show it.",
        "bench('steps red, green, yellow, red on ticks', (b) => {",
        "  b.row({ rst: 1, tick: 0, clk: 'C' }, { red: 1, yellow: 0, green: 0, state: 0 });",
        "  b.set({ rst: 0 });",
        "  b.table`",
        "    tick clk | red yellow green state",
        "    1    C   | 0   0      1     1",
        "    0    C   | 0   0      1     1      # no tick: stays",
        "    1    C   | 0   1      0     2",
        "    1    C   | 1   0      0     0",
        "    1    C   | 0   0      1     1",
        "  `;",
        "});",
        "",
        "bench('is unknown until reset', (b) => {",
        "  b.row({ rst: 0, tick: 1, clk: 'C' }, { red: 'X', green: 'X', state: 'X' });",
        "});",
        ""
      ]
    }
