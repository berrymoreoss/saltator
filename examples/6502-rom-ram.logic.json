      "wires": [],
      "probes": [
        { "ref": "PHI2" },
        { "ref": "RESB" },
        { "ref": "U1.SYNC" },
        { "ref": "U1.RWB" },
        { "ref": "A[0..15]" },
        { "ref": "D[0..7]" }
      ],
      "testScript": [
        "// 6502 ROM and RAM: a W65C02S (U1) runs a program from the AT28C256 (U2, at $8000–$FFFF),",
        "// its stack and data in the 62256 (U3, at $0000–$3FFF), decoded by a 74HC00 (U4) as in Ben",
        "// Eater's 6502. X1 is a 1 kHz clock, RESET (SW1) a button with a pull-up on RESB.",
        "// The program counts in RAM: INC $10, then a subroutine stores the count at $0200 too.",
        "bench('counts in RAM after RESET, a subroutine on the stack', (b) => {",
        "  b.press('SW1');",
        "  b.wait(ms(5) + 123457); // RESET over a few clock cycles, let go off the edges",
        "  b.release('SW1');",
        "  b.wait(ms(300));",
        "  const count = b.get('U3[10]');",
        "  const stored = b.get('U3[200]'); // the subroutine stores each count a few cycles after INC",
        "  if (typeof count !== 'number' || count < 5) b.fail(`U3[10] is ${count} after 300 ms`);",
        "  if (stored !== count && stored !== count - 1) b.fail(`U3[200] is ${stored}, U3[10] ${count}`);",
        "  b.expect({ 'U3[1FF]': 0x80, 'U3[1FE]': 0x0b }, 'JSR pushed its return address');",
        "  b.wait(ms(340)); // ten counts of 34 cycles at 1 kHz",
        "  b.expect({ 'U3[10]': count + 10, 'U3[200]': stored + 10 });",
        "});",
        ""
      ]
    }
  ]
}
