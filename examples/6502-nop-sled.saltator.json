      "wires": [],
      "probes": [
        { "ref": "PHI2" },
        { "ref": "RESB" },
        { "ref": "U1.SYNC" },
        { "ref": "U1.VPB" },
        { "ref": "U1.RWB" },
        { "ref": "A[0..15]" },
        { "ref": "D[0..7]" }
      ],
      "testScript": [
        "// 6502 NOP Sled: a W65C02S (U1) whose data bus D[0..7] reads $EA (NOP) through pull",
        "// resistors, as in Ben Eater's first 6502 video. X1 is a 10 Hz clock on PHI2; RESET (SW1) is a",
        "// button with a pull-up on RESB. The hex displays show the address bus A[0..15] and the data bus.",
        "bench('reads the reset vector $EAEA after RESET, then counts up through the NOPs', (b) => {",
        "  b.press('SW1'); // RESET held over three clock cycles (PHI2 falls every 100 ms) …",
        "  b.wait(ms(350) + 123457); // … and let go off the clock's edges",
        "  b.release('SW1');",
        "  // Seven cycles of reset sequence from the fall at 400 ms; the vector at 900 and 1000 ms.",
        "  // Each NOP is two cycles: the opcode fetch (SYNC) and a read of the next byte.",
        "  for (const [at, address, sync, vpb] of [",
        "    [925, 0xfffc, 0, 0],",
        "    [1025, 0xfffd, 0, 0],",
        "    [1125, 0xeaea, 1, 1],",
        "    [1225, 0xeaeb, 0, 1],",
        "    [1325, 0xeaeb, 1, 1],",
        "    [1425, 0xeaec, 0, 1],",
        "    [2125, 0xeaef, 1, 1],",
        "  ]) {",
        "    b.wait(ms(at) - b.now);",
        "    b.expect({ 'A[0..15]': address, 'U1.SYNC': sync, 'U1.VPB': vpb, 'U1.RWB': 1 }, `at ${at} ms`);",
        "  }",
        "  b.expect({ 'D[0..7]': 0xea });",
        "});",
        ""
      ]
