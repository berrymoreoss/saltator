{
  "schemaVersion": 6,
  "circuits": [
    {
      "id": "main",
      "name": "Main",
      "components": [
        { "id": "SW1", "type": "io/switch", "label": "A15", "x": 0, "y": 0, "props": { "contact": "spdt", "on": false } },
        { "id": "NL1", "type": "net/label", "x": 8, "y": 1, "props": { "name": "A15" } },
        { "id": "SW2", "type": "io/switch", "label": "A14", "x": 0, "y": 4, "props": { "contact": "spdt", "on": false } },
        { "id": "NL2", "type": "net/label", "x": 8, "y": 5, "props": { "name": "A14" } },
        { "id": "SW3", "type": "io/switch", "label": "A13", "x": 0, "y": 8, "props": { "contact": "spdt", "on": false } },
        { "id": "NL3", "type": "net/label", "x": 8, "y": 9, "props": { "name": "A13" } },
        { "id": "SW4", "type": "io/switch", "label": "A12", "x": 0, "y": 12, "props": { "contact": "spdt", "on": false } },
        { "id": "NL4", "type": "net/label", "x": 8, "y": 13, "props": { "name": "A12" } },
        { "id": "SW5", "type": "io/switch", "label": "PHI2", "x": 0, "y": 16, "props": { "contact": "spdt", "on": false } },
        { "id": "NL5", "type": "net/label", "x": 8, "y": 17, "props": { "name": "PHI2" } },
        { "id": "A1", "type": "sub/address-decoder", "x": 28, "y": 2, "props": { "delay": 15000 } },
        { "id": "NL6", "type": "net/label", "x": 23, "y": 4, "rotation": 180, "props": { "name": "A[15..12]" } },
        { "id": "NL7", "type": "net/label", "x": 23, "y": 5, "rotation": 180, "props": { "name": "PHI2" } },
        { "id": "NL8", "type": "net/label", "x": 44, "y": 4, "props": { "name": "RAM_CS" } },
        { "id": "D1", "type": "io/led", "label": "RAM", "x": 62, "y": 2, "rotation": 180, "props": { "color": "green" } },
        { "id": "NL11", "type": "net/label", "x": 54, "y": 1, "rotation": 180, "props": { "name": "RAM_CS" } },
        { "id": "V1", "type": "io/vcc", "x": 64, "y": 0 },
        { "id": "NL9", "type": "net/label", "x": 44, "y": 5, "props": { "name": "VIA_CS" } },
        { "id": "D2", "type": "io/led", "label": "VIA", "x": 62, "y": 7, "rotation": 180, "props": { "color": "green" } },
        { "id": "NL12", "type": "net/label", "x": 54, "y": 6, "rotation": 180, "props": { "name": "VIA_CS" } },
        { "id": "V2", "type": "io/vcc", "x": 64, "y": 5 },
        { "id": "NL10", "type": "net/label", "x": 44, "y": 6, "props": { "name": "ROM_CS" } },
        { "id": "D3", "type": "io/led", "label": "ROM", "x": 62, "y": 12, "rotation": 180, "props": { "color": "green" } },
        { "id": "NL13", "type": "net/label", "x": 54, "y": 11, "rotation": 180, "props": { "name": "ROM_CS" } },
        { "id": "V3", "type": "io/vcc", "x": 64, "y": 10 }
      ],
      "wires": [
        { "id": "w1", "from": [4, 1], "to": [8, 1] },
        { "id": "w2", "from": [4, 5], "to": [8, 5] },
        { "id": "w3", "from": [4, 9], "to": [8, 9] },
        { "id": "w4", "from": [4, 13], "to": [8, 13] },
        { "id": "w5", "from": [4, 17], "to": [8, 17] },
        { "id": "w6", "from": [28, 4], "to": [23, 4], "bus": true },
        { "id": "w7", "from": [28, 5], "to": [23, 5] },
        { "id": "w8", "from": [39, 4], "to": [44, 4] },
        { "id": "w9", "from": [58, 1], "to": [54, 1] },
        { "id": "w10", "from": [62, 1], "to": [65, 1] },
        { "id": "w11", "from": [65, 1], "to": [65, 2] },
        { "id": "w12", "from": [39, 5], "to": [44, 5] },
        { "id": "w13", "from": [58, 6], "to": [54, 6] },
        { "id": "w14", "from": [62, 6], "to": [65, 6] },
        { "id": "w15", "from": [65, 6], "to": [65, 7] },
        { "id": "w16", "from": [39, 6], "to": [44, 6] },
        { "id": "w17", "from": [58, 11], "to": [54, 11] },
        { "id": "w18", "from": [62, 11], "to": [65, 11] },
        { "id": "w19", "from": [65, 11], "to": [65, 12] }
      ],
      "testScript": [
        "// The board: A15-A12 and PHI2 switches, an LED on each chip select (lit when selected).",
        "const address = (b, high) =>",
        "  b.set({ SW1: (high >> 3) & 1, SW2: (high >> 2) & 1, SW3: (high >> 1) & 1, SW4: high & 1 });",
        "",
        "bench('lights the chip each address selects', (b) => {",
        "  b.set({ SW5: 1 });",
        "  for (const [high, ram, via, rom] of [",
        "    [0x0, 0, 1, 1],",
        "    [0x3, 0, 1, 1],",
        "    [0x4, 1, 1, 1],",
        "    [0x6, 1, 0, 1],",
        "    [0x7, 1, 0, 1],",
        "    [0x8, 1, 1, 0],",
        "    [0xf, 1, 1, 0],",
        "  ]) {",
        "    address(b, high);",
        "    b.wait(us(1));",
        "    b.expect({ RAM_CS: ram, VIA_CS: via, ROM_CS: rom }, `A15-A12 = ${high.toString(16)}`);",
        "  }",
        "});",
        "",
        "bench('keeps RAM deselected while PHI2 is LOW', (b) => {",
        "  address(b, 0x0);",
        "  b.set({ SW5: 0 });",
        "  b.wait(us(1));",
        "  b.expect({ RAM_CS: 1, VIA_CS: 1, ROM_CS: 1 });",
        "});",
        ""
      ]
    },
    {
      "id": "address-decoder",
      "name": "Address Decoder",
      "verilog": {
        "module": {
          "format": 1,
          "top": "address_decoder",
          "creator": "Yosys 0.70+post (git sha1 0c11ea098be065e585a90a06e7b7da49936cf231, Release, AppleClang clang++ 21.0.0.21000334)",
          "bitCount": 11,
          "ports": [
            { "name": "addr", "dir": "in", "lsb": 12, "bits": [0, 1, 2, 3], "src": "address_decoder.v:7.19-7.23" },
            { "name": "phi2", "dir": "in", "lsb": 0, "bits": [4], "src": "address_decoder.v:8.11-8.15" },
            { "name": "ram_cs_n", "dir": "out", "lsb": 0, "bits": [5], "src": "address_decoder.v:9.12-9.20" },
            { "name": "via_cs_n", "dir": "out", "lsb": 0, "bits": [6], "src": "address_decoder.v:10.12-10.20" },
            { "name": "rom_cs_n", "dir": "out", "lsb": 0, "bits": [7], "src": "address_decoder.v:11.12-11.20" }
          ],
          "signals": [],
          "cells": [
            { "type": "$logic_not", "src": "address_decoder.v:13.23-13.43", "ports": { "A": [2, 3], "Y": [8] }, "params": {} },
            { "type": "$eq", "src": "address_decoder.v:14.23-14.44", "ports": { "A": [1, 2, 3], "B": ["1", "1", "0"], "Y": [9] }, "params": {} },
            { "type": "$logic_and", "src": "address_decoder.v:13.23-13.51", "ports": { "A": [8], "B": [4], "Y": [10] }, "params": {} },
            { "type": "$not", "src": "address_decoder.v:13.21-13.52", "ports": { "A": [10], "Y": [5] }, "params": {} },
            { "type": "$not", "src": "address_decoder.v:14.21-14.45", "ports": { "A": [9], "Y": [6] }, "params": {} },
            { "type": "$not", "src": "address_decoder.v:15.21-15.30", "ports": { "A": [3], "Y": [7] }, "params": {} }
          ]
        }
      },
      "testScript": [
        "// The decoder alone, through its ports: every region of the memory map at its edges.",
        "bench('decodes the memory map', (b) => {",
        "  b.table`",
        "    addr[15..12] phi2 | ram_cs_n via_cs_n rom_cs_n",
        "    0x0          1    | 0        1        1         # RAM $0000",
        "    0x3          1    | 0        1        1         # RAM up to $3FFF",
        "    0x3          0    | 1        1        1         # RAM only while PHI2 is HIGH",
        "    0x4          1    | 1        1        1         # $4000-$5FFF: nothing",
        "    0x5          1    | 1        1        1",
        "    0x6          1    | 1        0        1         # VIA $6000",
        "    0x7          0    | 1        0        1         # VIA up to $7FFF, whatever PHI2",
        "    0x8          1    | 1        1        0         # ROM $8000",
        "    0xF          0    | 1        1        0         # ROM up to $FFFF",
        "  `;",
        "});",
        "",
        "bench('selects 15 ns after the address changes', (b) => {",
        "  b.set({ 'addr[15..12]': 0x0, phi2: 1 });",
        "  b.wait(us(1));",
        "  b.set({ 'addr[15..12]': 0x8 });",
        "  b.wait(ns(14));",
        "  b.expect({ rom_cs_n: 1, ram_cs_n: 0 }, 'not yet');",
        "  b.wait(ns(1));",
        "  b.expect({ rom_cs_n: 0, ram_cs_n: 1 }, 'after its delay');",
        "});",
        ""
      ]
    }
  ]
}
